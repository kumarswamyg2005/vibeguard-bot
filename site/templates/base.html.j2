<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}VibeGuard Bot{% endblock %}</title>
<meta name="description" content="An opt-in security engineer for Supabase apps. Finds missing RLS and leaked keys, opens small tested fix PRs.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ root }}assets/style.css">
</head>
<body>
<header class="top">
  <span class="brand">VibeGuard Bot</span>
  <a class="btn" href="{{ install_url }}">Install</a>
</header>
<main>
{% block body %}{% endblock %}
</main>
<footer>
  <p>VibeGuard Bot reads only repos it's installed on. It never reads your data —
  probes return row counts, not rows.</p>
</footer>
</body>
</html>
